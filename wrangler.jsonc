{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "code-portal-prod",
	"account_id": "83376df5e0bae067afa197b07430168d",
	"main": "custom-worker.ts",
	"workers_dev": true,
	"routes": [
		{
			"pattern": "ateneocode.org",
			"custom_domain": true
		}
	],
	"compatibility_date": "2026-06-10",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"binding": "ASSETS",
		"directory": ".open-next/assets"
	},
	"images": {
		"binding": "IMAGES"
	},
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			// Must match this file's own "name". It said code-nest, which no longer exists,
			// so every production upload failed with code 10143 until it was corrected.
			"service": "code-portal-prod"
		}
	],
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"vars": {
		"APP_ENV": "production",
		"DEPLOY_ENV": "prod",
		"STORAGE_MODE": "binding",
		"LOCAL_SQLITE_PATH": "./.local/dev.db",
		"LOCAL_STORAGE_DIR": "./.local/uploads",
		"NEXT_PRIVATE_MINIMAL_MODE": "1",
		// Unfinished surfaces stay hidden in production until each one ships. Only "true" enables.
		"FEATURE_RETENTION": "true",
		"FEATURE_LIBRARY": "false",
		"FEATURE_ANNOUNCEMENTS": "true",
		"FEATURE_NOTIFICATIONS": "true",
		"FEATURE_SURVEYS": "false",
		"FEATURE_PUBLIC_SITE": "false",
		"FEATURE_LEADERBOARD": "true",
		"FEATURE_LIBRARY_SMART_SEARCH": "false",
		"FEATURE_EMAIL": "true",
		"FEATURE_MENTS": "true",
		"FEATURE_GALLERY": "false",
		"EMAIL_INBOX_ADDRESS": "inbox@ateneocode.org",
		"EMAIL_PUBLIC_BASE_URL": "https://ateneocode.org",
		"EMAIL_BATCH_PER_TICK": "25",
		"EMAIL_DAILY_CAP": "300"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "code-nest-prod-db",
			"database_id": "d5505f3a-5bf4-438e-b14f-dd595b9a24d6",
			// One history now, shared by every environment. Its 0000 to 0003 are the files
			// production has always had, so D1 sees them as applied and only 0004 is pending.
			"migrations_dir": "drizzle/migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "BUCKET",
			"bucket_name": "code-nest-prod-uploads"
		}
	],
	"send_email": [{ "name": "EMAIL" }],
	"queues": {
		"producers": [{ "binding": "EMAIL_JOBS", "queue": "code-portal-prod-email" }],
		"consumers": [{ "queue": "code-portal-prod-email", "max_batch_size": 1, "max_batch_timeout": 0, "max_concurrency": 1, "max_retries": 5, "retry_delay": 60, "dead_letter_queue": "code-portal-prod-email-failed" }]
	},
	"triggers": { "crons": ["* * * * *"] }
}
